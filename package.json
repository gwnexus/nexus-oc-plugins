{
  "name": "nexus-oc-plugins",
  "version": "1.6.0",
  "description": "OpenCode plugins for the Gatewarden Nexus platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fmt": "prettier --check \"**/*.ts\"",
    "fmt:fix": "prettier --write \"**/*.ts\""
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.14.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  }
}
